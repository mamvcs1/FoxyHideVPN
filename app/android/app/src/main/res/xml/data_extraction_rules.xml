<?xml version="1.0" encoding="utf-8"?>
<!-- Keep non-sensitive preferences, but never transfer VPN credentials or local secrets. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="core/logs/" />
        <exclude domain="file" path="core/routing/" />
        <exclude domain="file" path="core/servers.json" />
        <exclude domain="file" path="core/status.json" />
        <exclude domain="file" path="core/local-api.token" />
        <exclude domain="file" path="core/accounts/" />
        <exclude domain="file" path="core/config.json" />
        <exclude domain="file" path="core/dashboard.key" />
        <exclude domain="file" path="core/tun2socks.yml" />
        <exclude domain="file" path="core/update/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="core/logs/" />
        <exclude domain="file" path="core/routing/" />
        <exclude domain="file" path="core/servers.json" />
        <exclude domain="file" path="core/status.json" />
        <exclude domain="file" path="core/local-api.token" />
        <exclude domain="file" path="core/accounts/" />
        <exclude domain="file" path="core/config.json" />
        <exclude domain="file" path="core/dashboard.key" />
        <exclude domain="file" path="core/tun2socks.yml" />
        <exclude domain="file" path="core/update/" />
    </device-transfer>
</data-extraction-rules>
